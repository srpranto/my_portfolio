---
import { skillCategories } from '../data/portfolio';
---

<section id="skills" class="py-16 md:py-24 border-b border-[var(--edge)] bg-[var(--bg)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Section Header -->
    <div class="flex items-center justify-between pb-6 border-b border-[var(--edge)] font-mono-code text-xs text-[var(--fg-muted)]">
      <div class="flex items-center gap-2">
        <span class="text-[var(--accent)] font-semibold">02 //</span>
        <span class="uppercase tracking-wider font-semibold text-[var(--fg)]">SKILLS</span>
      </div>
      <span class="badge-mono">technologies</span>
    </div>

    <!-- Intro Headline -->
    <div class="pt-8 pb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[var(--fg)]">
          Technical Skills
        </h2>
        <p class="text-sm text-[var(--fg-muted)] mt-1 max-w-xl text-pretty font-sans">
          Languages, libraries, and tools I use regularly in development.
        </p>
      </div>

      <!-- Quick category filter buttons -->
      <div class="flex flex-wrap items-center gap-1.5 font-mono-code text-xs">
        <button type="button" class="skill-filter-btn px-2.5 py-1 border border-[var(--fg)] bg-[var(--fg)] text-[var(--bg)] rounded-xs" data-filter="all">All</button>
        <button type="button" class="skill-filter-btn px-2.5 py-1 border border-[var(--edge)] bg-[var(--panel)] text-[var(--fg-muted)] hover:text-[var(--fg)] rounded-xs" data-filter="frontend">Frontend</button>
        <button type="button" class="skill-filter-btn px-2.5 py-1 border border-[var(--edge)] bg-[var(--panel)] text-[var(--fg-muted)] hover:text-[var(--fg)] rounded-xs" data-filter="backend">Backend</button>
        <button type="button" class="skill-filter-btn px-2.5 py-1 border border-[var(--edge)] bg-[var(--panel)] text-[var(--fg-muted)] hover:text-[var(--fg)] rounded-xs" data-filter="data">Data & Auth</button>
        <button type="button" class="skill-filter-btn px-2.5 py-1 border border-[var(--edge)] bg-[var(--panel)] text-[var(--fg-muted)] hover:text-[var(--fg)] rounded-xs" data-filter="tools">Tools</button>
      </div>
    </div>

    <!-- Graphical Categorized Skills Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
      {skillCategories.map((cat, idx) => {
        let filterCategory = 'frontend';
        if (cat.title.toLowerCase().includes('backend')) filterCategory = 'backend';
        else if (cat.title.toLowerCase().includes('data')) filterCategory = 'data';
        else if (cat.title.toLowerCase().includes('tools')) filterCategory = 'tools';

        let categoryIcon = 'code';
        if (filterCategory === 'backend') categoryIcon = 'server';
        else if (filterCategory === 'data') categoryIcon = 'database';
        else if (filterCategory === 'tools') categoryIcon = 'terminal';

        return (
          <div class="corner-box p-6 flex flex-col justify-between skill-cat-card" data-category={filterCategory}>
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-[var(--edge)]">
                <div class="font-mono-code text-xs text-[var(--accent)] font-semibold flex items-center gap-2">
                  {categoryIcon === 'code' && (
                    <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
                  )}
                  {categoryIcon === 'server' && (
                    <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="8" rx="2" stroke-width="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" stroke-width="2"></rect><line x1="6" y1="6" x2="6.01" y2="6" stroke-width="2"></line><line x1="6" y1="18" x2="6.01" y2="18" stroke-width="2"></line></svg>
                  )}
                  {categoryIcon === 'database' && (
                    <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3" stroke-width="2"></ellipse><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
                  )}
                  {categoryIcon === 'terminal' && (
                    <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="4 17 10 11 4 5" stroke-width="2"></polyline><line x1="12" y1="19" x2="20" y2="19" stroke-width="2"></line></svg>
                  )}
                  <span>0{idx + 1}.</span>
                  <span class="text-[var(--fg)] uppercase tracking-wider">{cat.title}</span>
                </div>
                <span class="text-[11px] font-mono-code text-[var(--fg-muted)]">{cat.skills.length} skills</span>
              </div>
              <p class="text-xs text-[var(--fg-muted)] mt-2 mb-4 leading-relaxed font-sans">
                {cat.description}
              </p>

              <!-- Skills items grid with clean typographic pills -->
              <div class="flex flex-wrap gap-2">
                {cat.skills.map((skill) => (
                  <div
                    class={`group px-2.5 py-1.5 border rounded-xs font-mono-code text-xs flex items-center gap-2 transition-all duration-150 cursor-default select-none ${
                      skill.highlight
                        ? 'border-[var(--accent-border)] bg-[var(--accent-soft)] text-[var(--fg)] font-medium'
                        : 'border-[var(--edge)] bg-[var(--panel-alt)] text-[var(--fg-muted)] hover:text-[var(--fg)] hover:border-[var(--edge-strong)]'
                    }`}
                  >
                    {skill.highlight && (
                      <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] shrink-0"></span>
                    )}
                    <span>{skill.name}</span>
                    <span class="text-[10px] text-[var(--fg-faint)] group-hover:text-[var(--fg-muted)] transition-colors">
                      {skill.level}
                    </span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Footnote -->
            <div class="mt-6 pt-3 border-t border-[var(--edge)] flex items-center justify-between text-[11px] font-mono-code text-[var(--fg-muted)]">
              <span class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-[var(--accent)]"></span>
                <span>Active Stack</span>
              </span>
              <span class="text-[var(--fg-faint)]">Current Projects</span>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Supplementary Highlights Matrix -->
    <div class="mt-8 corner-box p-5 bg-[var(--panel-alt)]">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-[var(--edge)]">
        <span class="font-mono-code text-xs font-semibold text-[var(--fg)] uppercase tracking-wider flex items-center gap-2">
          <span>◈</span> Core Competencies
        </span>
        <span class="font-mono-code text-[11px] text-[var(--fg-muted)]">
          TypeScript • React • Next.js • Node.js • Tailwind CSS
        </span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 text-center font-mono-code text-xs">
        <div class="p-3 border border-[var(--edge)] bg-[var(--panel)] rounded-xs">
          <div class="text-base font-bold text-[var(--accent)]">Type Safe</div>
          <div class="text-[11px] text-[var(--fg-muted)] mt-1">TypeScript Strict Mode</div>
        </div>
        <div class="p-3 border border-[var(--edge)] bg-[var(--panel)] rounded-xs">
          <div class="text-base font-bold text-[var(--accent)]">Responsive</div>
          <div class="text-[11px] text-[var(--fg-muted)] mt-1">Mobile-First Layouts</div>
        </div>
        <div class="p-3 border border-[var(--edge)] bg-[var(--panel)] rounded-xs">
          <div class="text-base font-bold text-[var(--accent)]">Performance</div>
          <div class="text-[11px] text-[var(--fg-muted)] mt-1">Fast Initial Load</div>
        </div>
        <div class="p-3 border border-[var(--edge)] bg-[var(--panel)] rounded-xs">
          <div class="text-base font-bold text-[var(--accent)]">Accessible</div>
          <div class="text-[11px] text-[var(--fg-muted)] mt-1">Semantic HTML & ARIA</div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Filter buttons interaction
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.skill-filter-btn');
    const skillCards = document.querySelectorAll('.skill-cat-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update active button styling
        filterBtns.forEach((b) => {
          b.classList.remove('border-[var(--fg)]', 'bg-[var(--fg)]', 'text-[var(--bg)]');
          b.classList.add('border-[var(--edge)]', 'bg-[var(--panel)]', 'text-[var(--fg-muted)]');
        });
        btn.classList.add('border-[var(--fg)]', 'bg-[var(--fg)]', 'text-[var(--bg)]');
        btn.classList.remove('border-[var(--edge)]', 'bg-[var(--panel)]', 'text-[var(--fg-muted)]');

        // Show/hide cards
        skillCards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  });
</script>
