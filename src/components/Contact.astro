---
import { personalInfo } from '../data/portfolio';
---

<section id="contact" class="py-16 md:py-24 border-b border-[var(--edge)] bg-[var(--bg)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Section Header -->
    <div class="flex items-center justify-between pb-6 border-b border-[var(--edge)] font-mono-code text-xs text-[var(--fg-muted)]">
      <div class="flex items-center gap-2">
        <span class="text-[var(--accent)] font-semibold">06 //</span>
        <span class="uppercase tracking-wider font-semibold text-[var(--fg)]">CONTACT</span>
      </div>
      <span class="badge-mono">get-in-touch</span>
    </div>

    <!-- Intro Headline -->
    <div class="pt-8 pb-8">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-[-0.025em] text-[var(--fg)] text-balance">
        Get in Touch
      </h2>
      <p class="text-sm text-[var(--fg-muted)] mt-1.5 max-w-xl text-pretty leading-relaxed">
        Have a question, a project in mind, or an open role? Reach out through any channel below.
      </p>
    </div>

    <!-- Contact Grid: Left Direct Details + Right Message Form -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
      <!-- Direct Contact Channels (Requirement 10) (Col 1-5) -->
      <div class="lg:col-span-5 space-y-4">
        <!-- Direct Email Card -->
        <div class="corner-box p-5 space-y-2 hover:border-[var(--accent-border)] transition-colors">
          <div class="flex items-center justify-between">
            <span class="font-mono-code text-xs uppercase text-[var(--fg-muted)] font-semibold flex items-center gap-1.5">
              <span class="text-[var(--accent)] font-bold">//</span> Email
            </span>
            <button
              type="button"
              class="copy-btn text-[11px] font-mono-code text-[var(--accent)] hover:underline"
              data-copy={personalInfo.email}
            >
              Copy
            </button>
          </div>
          <a
            href={`mailto:${personalInfo.email}`}
            class="text-base sm:text-lg font-bold text-[var(--fg)] hover:text-[var(--accent)] transition-colors block break-all font-mono-code"
          >
            {personalInfo.email}
          </a>
          <p class="text-xs text-[var(--fg-muted)]">
            I typically respond within 24 hours.
          </p>
        </div>

        <!-- Direct Phone & WhatsApp Card (Requirement 10) -->
        <div class="corner-box p-5 space-y-2 hover:border-[var(--accent-border)] transition-colors">
          <div class="flex items-center justify-between">
            <span class="font-mono-code text-xs uppercase text-[var(--fg-muted)] font-semibold flex items-center gap-1.5">
              <span class="text-[var(--accent)] font-bold">//</span> Phone & WhatsApp
            </span>
            <button
              type="button"
              class="copy-btn text-[11px] font-mono-code text-[var(--accent)] hover:underline"
              data-copy={personalInfo.phone}
            >
              Copy
            </button>
          </div>
          <div class="flex flex-col sm:flex-row sm:items-center gap-3">
            <a
              href={`tel:${personalInfo.phone}`}
              class="text-base sm:text-lg font-bold text-[var(--fg)] hover:text-[var(--accent)] transition-colors font-mono-code tabular-nums"
            >
              {personalInfo.phone}
            </a>
            <a
              href={personalInfo.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-dj btn-dj-accent text-xs py-1 px-2.5 inline-flex self-start"
            >
              <span>Message on WhatsApp ↗</span>
            </a>
          </div>
          <p class="text-xs text-[var(--fg-muted)]">
            Available 9:00 AM – 10:00 PM BST.
          </p>
        </div>

        <!-- Location Card -->
        <div class="corner-box p-5 space-y-2">
          <span class="font-mono-code text-xs uppercase text-[var(--fg-muted)] font-semibold flex items-center gap-1.5">
            <span class="text-[var(--accent)] font-bold">//</span> Location & Timezone
          </span>
          <div class="text-sm font-semibold text-[var(--fg)] font-mono-code">
            {personalInfo.location}
          </div>
          <div class="text-xs text-[var(--fg-muted)] font-mono-code">
            Bangladesh Standard Time (BST) • UTC+6
          </div>
        </div>
      </div>

      <!-- Interactive Contact Message Form (Col 6-12) -->
      <div class="lg:col-span-7">
        <div class="corner-box p-6 md:p-8 space-y-5">
          <div class="flex items-center justify-between pb-3 border-b border-[var(--edge)]">
            <span class="font-mono-code text-xs uppercase font-semibold text-[var(--fg)] flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[var(--accent)]"></span>
              Send a Message
            </span>
            <span class="font-mono-code text-[11px] text-[var(--fg-muted)]">Opens email draft</span>
          </div>

          <form id="contact-form" data-recipient={personalInfo.email} class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1">
                <label for="contact-name" class="block font-mono-code text-xs text-[var(--fg)] font-medium">
                  Your Name <span class="text-rose-500">*</span>
                </label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  placeholder="e.g. Alex Morgan"
                  class="w-full px-3 py-2 border border-[var(--edge)] bg-[var(--panel-alt)] text-[var(--fg)] text-xs font-mono-code focus:outline-none focus:border-[var(--accent)] rounded-xs"
                />
              </div>

              <div class="space-y-1">
                <label for="contact-email" class="block font-mono-code text-xs text-[var(--fg)] font-medium">
                  Your Email <span class="text-rose-500">*</span>
                </label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  required
                  placeholder="e.g. alex@example.com"
                  class="w-full px-3 py-2 border border-[var(--edge)] bg-[var(--panel-alt)] text-[var(--fg)] text-xs font-mono-code focus:outline-none focus:border-[var(--accent)] rounded-xs"
                />
              </div>
            </div>

            <div class="space-y-1">
              <label for="contact-subject" class="block font-mono-code text-xs text-[var(--fg)] font-medium">
                Subject
              </label>
              <input
                type="text"
                id="contact-subject"
                name="subject"
                placeholder="e.g. Frontend developer opportunity / Project inquiry"
                class="w-full px-3 py-2 border border-[var(--edge)] bg-[var(--panel-alt)] text-[var(--fg)] text-xs font-mono-code focus:outline-none focus:border-[var(--accent)] rounded-xs"
              />
            </div>

            <div class="space-y-1">
              <label for="contact-message" class="block font-mono-code text-xs text-[var(--fg)] font-medium">
                Message <span class="text-rose-500">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="4"
                required
                placeholder="Write your note here..."
                class="w-full px-3 py-2 border border-[var(--edge)] bg-[var(--panel-alt)] text-[var(--fg)] text-xs font-mono-code focus:outline-none focus:border-[var(--accent)] rounded-xs resize-y"
              ></textarea>
            </div>

            <div class="flex items-center justify-between pt-2">
              <span id="form-status" class="font-mono-code text-xs text-emerald-500 hidden"></span>
              <button
                type="submit"
                id="contact-submit-btn"
                class="btn-dj btn-dj-primary text-xs py-2.5 px-5 ml-auto"
              >
                <span>Send Message →</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Copy buttons
    const copyBtns = document.querySelectorAll('.copy-btn');
    copyBtns.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy');
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          const original = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => {
            btn.textContent = original;
          }, 2000);
        } catch (e) {
          console.error(e);
        }
      });
    });

    // Contact Form handling
    const form = document.getElementById('contact-form');
    const statusEl = document.getElementById('form-status');

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const recipient = form.getAttribute('data-recipient');
        const name = document.getElementById('contact-name')?.value || '';
        const email = document.getElementById('contact-email')?.value || '';
        const subject = document.getElementById('contact-subject')?.value || 'Portfolio Inquiry';
        const message = document.getElementById('contact-message')?.value || '';

        const mailtoUrl = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(`Hi Shahil,\n\n${message}\n\nFrom: ${name} (${email})`)}`;

        if (statusEl) {
          statusEl.textContent = 'Opening your email client...';
          statusEl.classList.remove('hidden');
        }

        window.location.href = mailtoUrl;

        setTimeout(() => {
          form.reset();
          if (statusEl) {
            statusEl.textContent = 'Message prepared. Thank you!';
            setTimeout(() => {
              statusEl.classList.add('hidden');
            }, 5000);
          }
        }, 1500);
      });
    }
  });
</script>
