---
import { personalInfo } from '../data/portfolio';
import SecretsModal from './SecretsModal.astro';
import HangingLamp from './HangingLamp.astro';
---

<header id="site-header" class="bar">
  <div class="inner">
    <!-- Brand / Home link with devjhawar logo & "click me" secrets trigger -->
    <div class="relative flex items-center shrink-0">
      <button
        type="button"
        id="nav-brand-logo"
        class="mark focus:outline-none"
        aria-label="Toggle developer secrets terminal"
      >
        <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" class="shrink-0">
          <rect x="1" y="1" width="22" height="22" class="fill-[var(--fg)]"></rect>
          <rect x="12" y="12" width="11" height="11" class="fill-[var(--accent)] transition-colors duration-300"></rect>
        </svg>
        <span class="who">
          <span class="who-name font-mono-code">{personalInfo.name}</span>
          <small class="hint mono" id="hint">click me</small>
        </span>
      </button>

      <!-- Secrets Console Terminal Modal -->
      <SecretsModal />
    </div>

    <!-- Desktop Navigation Links -->
    <nav class="sections hidden lg:flex font-mono-code" aria-label="Sections">
      <a href="/#about">01. About</a>
      <a href="/#skills">02. Skills</a>
      <a href="/#projects">03. Projects</a>
      <a href="/#open-source">04. Open Source</a>
      <a href="/#experience">05. Experience</a>
      <a href="/#contact">06. Contact</a>
    </nav>

    <!-- Toolbar on the Right: Search, Accent Popover, Sound, Resume, Lamp, Mobile Toggle -->
    <div class="right">
      <!-- Search Button (Ctrl+K) -->
      <button
        class="find hidden sm:inline-flex font-mono-code"
        id="nav-search-btn"
        type="button"
        aria-label="Search the site"
        aria-keyshortcuts="Control+K Meta+K"
      >
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="7" cy="7" r="5"></circle>
          <path d="m11 11 3.5 3.5"></path>
        </svg>
        <span class="lbl">Search</span>
        <kbd class="mono" id="find-key">Ctrl K</kbd>
      </button>

      <!-- devjhawar Signature Accent Button -->
      <button
        class="sq"
        id="accent-btn"
        type="button"
        popovertarget="accents"
        aria-label="Choose an accent colour"
        title="Choose accent color"
      >
        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
          <rect x="1.5" y="1.5" width="6" height="6" style="--c:#2b37e6;--cd:#7d87ff"></rect>
          <rect x="8.5" y="1.5" width="6" height="6" style="--c:#6b2fd6;--cd:#b48cff"></rect>
          <rect x="1.5" y="8.5" width="6" height="6" style="--c:#c4234f;--cd:#ff7a9c"></rect>
          <rect x="8.5" y="8.5" width="6" height="6" style="--c:#9a4d00;--cd:#ffb547"></rect>
        </svg>
      </button>

      <!-- devjhawar Native HTML Popover Swatch Bar -->
      <div class="accents" id="accents" popover="" aria-label="Accent colour">
        <button type="button" data-accent-pick="blue" aria-label="Blue" title="Blue" aria-pressed="true" style="--c:#2b37e6;--cd:#7d87ff"></button>
        <button type="button" data-accent-pick="violet" aria-label="Violet" title="Violet" aria-pressed="false" style="--c:#6b2fd6;--cd:#b48cff"></button>
        <button type="button" data-accent-pick="rose" aria-label="Rose" title="Rose" aria-pressed="false" style="--c:#c4234f;--cd:#ff7a9c"></button>
        <button type="button" data-accent-pick="amber" aria-label="Amber" title="Amber" aria-pressed="false" style="--c:#9a4d00;--cd:#ffb547"></button>
        <button type="button" data-accent-pick="teal" aria-label="Teal" title="Teal" aria-pressed="false" style="--c:#08705f;--cd:#3fd0bf"></button>
      </div>

      <!-- Sound Toggle Button -->
      <button
        class="sq"
        id="nav-sound-btn"
        type="button"
        title="Toggle Sound Effects (Key: M)"
        aria-label="Toggle sound effects"
      >
        <svg id="sound-icon-on" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path>
        </svg>
        <svg id="sound-icon-off" class="w-4 h-4 hidden text-[var(--fg-faint)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"></path>
        </svg>
      </button>

      <!-- Résumé Button -->
      <a
        class="btn-resume hidden sm:inline-flex font-mono-code"
        href={personalInfo.resumeUrl}
        target="_blank"
        rel="noopener noreferrer"
        title="View & Download Résumé"
      >
        <span>Résumé</span>
        <span class="arr">↗</span>
      </a>

      <!-- Hanging Pendant Lamp -->
      <HangingLamp />

      <!-- Mobile Hamburger Button -->
      <button
        class="sq lg:hidden"
        id="nav-mobile-toggle"
        type="button"
        aria-label="Toggle navigation menu"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Backdrop & Menu -->
  <div id="nav-mobile-backdrop" class="fixed inset-0 top-[3.75rem] bg-black/40 backdrop-blur-xs z-30 lg:hidden hidden"></div>
  <div id="nav-mobile-drawer" class="lg:hidden hidden border-t border-[var(--edge)] bg-[var(--panel)] px-4 py-4 space-y-3 font-mono-code text-sm relative z-40 shadow-xl">
    <div class="flex flex-col space-y-2">
      <a href="/#about" class="mobile-nav-link py-1.5 text-[var(--fg-muted)] hover:text-[var(--fg)]">01. About</a>
      <a href="/#skills" class="mobile-nav-link py-1.5 text-[var(--fg-muted)] hover:text-[var(--fg)]">02. Skills</a>
      <a href="/#projects" class="mobile-nav-link py-1.5 text-[var(--fg-muted)] hover:text-[var(--fg)]">03. Projects</a>
      <a href="/#open-source" class="mobile-nav-link py-1.5 text-[var(--fg-muted)] hover:text-[var(--fg)]">04. Open Source</a>
      <a href="/#experience" class="mobile-nav-link py-1.5 text-[var(--fg-muted)] hover:text-[var(--fg)]">05. Experience</a>
      <a href="/#contact" class="mobile-nav-link py-1.5 text-[var(--fg-muted)] hover:text-[var(--fg)]">06. Contact</a>
    </div>

    <div class="pt-3 border-t border-[var(--edge)] flex flex-col gap-2">
      <a
        href={personalInfo.resumeUrl}
        download="MD_Shahil_Resume.pdf"
        class="btn-resume text-center justify-center py-2"
      >
        Download Résumé (PDF) ↓
      </a>
      <button
        id="mobile-search-btn"
        type="button"
        class="find text-center justify-center py-2 w-full"
      >
        Quick Search (Ctrl + K)
      </button>
    </div>
  </div>
</header>

<script is:inline>
  // devjhawar Accent Switcher Logic with Native HTML Popover
  const accentBtn = document.getElementById('accent-btn');
  const accentsPopover = document.getElementById('accents');
  const accentPicks = [...document.querySelectorAll('[data-accent-pick]')];

  function syncAccentUI() {
    const cur = document.documentElement.dataset.accent || 'blue';
    accentPicks.forEach(btn => {
      btn.setAttribute('aria-pressed', String(btn.dataset.accentPick === cur));
    });
  }
  syncAccentUI();

  // Position popover right below the trigger button
  accentsPopover?.addEventListener('beforetoggle', (e) => {
    if (e.newState !== 'open') return;
    if (accentBtn) {
      const rect = accentBtn.getBoundingClientRect();
      accentsPopover.style.top = `${rect.bottom + 8}px`;
      accentsPopover.style.right = `${Math.max(8, window.innerWidth - rect.right)}px`;
    }
  });

  accentPicks.forEach((btn) => {
    btn.addEventListener('click', () => {
      const pick = btn.dataset.accentPick;
      if (pick === 'blue') {
        delete document.documentElement.dataset.accent;
      } else if (pick) {
        document.documentElement.dataset.accent = pick;
      }
      try {
        if (pick === 'blue') {
          localStorage.removeItem('accent');
          localStorage.removeItem('dj-accent');
        } else if (pick) {
          localStorage.setItem('accent', pick);
          localStorage.setItem('dj-accent', pick);
        }
      } catch (err) {}
      if (typeof window.__playAccentChime === 'function') {
        window.__playAccentChime(pick || 'blue');
      } else if (typeof window.__playLampClick === 'function') {
        window.__playLampClick();
      }
      syncAccentUI();
      try {
        if (typeof accentsPopover?.hidePopover === 'function') {
          accentsPopover.hidePopover();
        }
      } catch (e) {}
    });
  });

  // Sound UI updates
  const soundBtn = document.getElementById('nav-sound-btn');
  const soundIconOn = document.getElementById('sound-icon-on');
  const soundIconOff = document.getElementById('sound-icon-off');

  function updateSoundUI(enabled) {
    if (enabled) {
      soundIconOn?.classList.remove('hidden');
      soundIconOff?.classList.add('hidden');
    } else {
      soundIconOn?.classList.add('hidden');
      soundIconOff?.classList.remove('hidden');
    }
  }

  // Initial sound UI synchronization
  try {
    const savedSound = localStorage.getItem('dj-sound-enabled');
    if (savedSound !== null) {
      updateSoundUI(savedSound === 'true');
    } else {
      updateSoundUI(true);
    }
  } catch (e) {}

  soundBtn?.addEventListener('click', () => {
    if (window.__toggleSound) {
      const state = window.__toggleSound();
      updateSoundUI(state);
    }
  });

  window.addEventListener('sound-toggle-changed', (e) => {
    updateSoundUI(e.detail.enabled);
  });

  // Mobile menu toggle with backdrop overlay and scroll lock
  const mobileToggle = document.getElementById('nav-mobile-toggle');
  const mobileDrawer = document.getElementById('nav-mobile-drawer');
  const mobileBackdrop = document.getElementById('nav-mobile-backdrop');

  function openMobileDrawer() {
    mobileDrawer?.classList.remove('hidden');
    mobileBackdrop?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeMobileDrawer() {
    mobileDrawer?.classList.add('hidden');
    mobileBackdrop?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  mobileToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (mobileDrawer?.classList.contains('hidden')) {
      openMobileDrawer();
    } else {
      closeMobileDrawer();
    }
  });

  mobileBackdrop?.addEventListener('click', closeMobileDrawer);

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      closeMobileDrawer();
    });
  });

  // Outside click & ESC dismissal for mobile drawer
  document.addEventListener('click', (e) => {
    if (!e.target.closest('#nav-mobile-drawer') && !e.target.closest('#nav-mobile-toggle')) {
      closeMobileDrawer();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeMobileDrawer();
      try {
        if (typeof accentsPopover?.hidePopover === 'function') {
          accentsPopover.hidePopover();
        }
      } catch (err) {}
    }
  });

  // Search trigger
  document.getElementById('nav-brand-logo')?.addEventListener('click', (e) => {
    e.preventDefault();
    if (typeof window.__toggleSecretsModal === 'function') {
      window.__toggleSecretsModal();
    }
  });

  document.getElementById('nav-search-btn')?.addEventListener('click', () => {
    window.__openCommandPalette && window.__openCommandPalette();
  });
  document.getElementById('mobile-search-btn')?.addEventListener('click', () => {
    closeMobileDrawer();
    window.__openCommandPalette && window.__openCommandPalette();
  });

  // Sticky Navbar Scroll Elevation & Top Spy
  const header = document.getElementById('site-header');
  const navLinks = document.querySelectorAll('nav.sections a[href^="/#"]');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
      // Highlight top link when at top of page
      if (window.scrollY < 100 && navLinks[0]) {
        navLinks.forEach((l, idx) => l.classList.toggle('active', idx === 0));
      }
    }
  }, { passive: true });

  // Active Section Navigation Spy
  const sectionIds = ['about', 'skills', 'projects', 'open-source', 'experience', 'contact'];
  const sections = sectionIds.map(id => document.getElementById(id)).filter(Boolean);

  if (sections.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          navLinks.forEach(link => {
            if (link.getAttribute('href') === `/#${id}`) {
              link.classList.add('active');
            } else {
              link.classList.remove('active');
            }
          });
        }
      });
    }, { rootMargin: '-15% 0px -65% 0px' });

    sections.forEach(s => observer.observe(s));
  }
</script>
