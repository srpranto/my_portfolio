---
// SoundManager component: Web Audio API sound synthesis + mute toggle
---
<script is:inline>
  // Web Audio click synth
  let audioCtx = null;
  let soundEnabled = true;

  try {
    const saved = localStorage.getItem('dj-sound-enabled');
    if (saved !== null) {
      soundEnabled = saved === 'true';
    }
  } catch (e) {}

  function getAudioContext() {
    if (!audioCtx) {
      const AudioContextClass = window.AudioContext || window['webkitAudioContext'];
      if (AudioContextClass) {
        audioCtx = new AudioContextClass();
      }
    }
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  function playBlip(freq = 750, duration = 0.04) {
    if (!soundEnabled) return;
    try {
      const ctx = getAudioContext();
      if (!ctx) return;

      const osc = ctx.createOscillator();
      const gain = ctx.createGain();

      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(freq * 0.45, ctx.currentTime + duration);

      gain.gain.setValueAtTime(0.08, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);

      osc.connect(gain);
      gain.connect(ctx.destination);

      osc.start();
      osc.stop(ctx.currentTime + duration);
    } catch (err) {
      // Audio playback silently handled
    }
  }

  function playPacmanChomp() {
    if (!soundEnabled) return;
    try {
      const ctx = getAudioContext();
      if (!ctx) return;

      const osc = ctx.createOscillator();
      const gain = ctx.createGain();

      osc.type = 'triangle';
      const now = ctx.currentTime;
      // Classic Pacman "waka" frequency sweep: 240Hz down to 140Hz or 180Hz to 320Hz
      osc.frequency.setValueAtTime(260, now);
      osc.frequency.exponentialRampToValueAtTime(140, now + 0.08);

      gain.gain.setValueAtTime(0.09, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);

      osc.connect(gain);
      gain.connect(ctx.destination);

      osc.start();
      osc.stop(now + 0.08);
    } catch (e) {}
  }

  let noiseBuf = null;
  function getNoiseBuffer(ctx) {
    if (!noiseBuf) {
      noiseBuf = ctx.createBuffer(1, Math.ceil(ctx.sampleRate * 0.05), ctx.sampleRate);
      const data = noiseBuf.getChannelData(0);
      for (let i = 0; i < data.length; i++) {
        data[i] = Math.random() * 2 - 1;
      }
    }
    return noiseBuf;
  }

  function playNoiseBurst(ctx, freq, gainVal, durationMs = 30) {
    try {
      const now = ctx.currentTime;
      const src = ctx.createBufferSource();
      const filter = ctx.createBiquadFilter();
      const gain = ctx.createGain();

      src.buffer = getNoiseBuffer(ctx);
      filter.type = 'bandpass';
      filter.frequency.value = freq;
      filter.Q.value = 1.6;

      gain.gain.setValueAtTime(gainVal, now);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + durationMs / 1000);

      src.connect(filter);
      filter.connect(gain);
      gain.connect(ctx.destination);

      src.start(now);
      src.stop(now + durationMs / 1000 + 0.01);
    } catch (e) {}
  }

  function playLampClick(isTurningOn) {
    if (!soundEnabled) return;
    try {
      const ctx = getAudioContext();
      if (!ctx) return;

      if (isTurningOn === undefined) {
        // If not specified, infer: if root currently has dark, clicking turns light (ON)
        const root = document.documentElement;
        const isDark = root.getAttribute('data-theme') === 'dark' || root.classList.contains('dark');
        isTurningOn = isDark;
      }

      const now = ctx.currentTime;

      if (isTurningOn) {
        // --- LAMP TURN ON: Crisp pull-chain snap + bright warm bulb ignition glow ---
        playNoiseBurst(ctx, 2400, 0.45, 30);

        // Mechanical switch contact
        const osc1 = ctx.createOscillator();
        const gain1 = ctx.createGain();
        osc1.type = 'triangle';
        osc1.frequency.setValueAtTime(620, now);
        osc1.frequency.exponentialRampToValueAtTime(880, now + 0.04);
        gain1.gain.setValueAtTime(0.18, now);
        gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.07);
        osc1.connect(gain1);
        gain1.connect(ctx.destination);
        osc1.start(now);
        osc1.stop(now + 0.07);

        // Warm electrical filament bell/chime (light turning on)
        const osc2 = ctx.createOscillator();
        const gain2 = ctx.createGain();
        osc2.type = 'sine';
        osc2.frequency.setValueAtTime(1200, now + 0.015);
        osc2.frequency.exponentialRampToValueAtTime(1480, now + 0.12);
        gain2.gain.setValueAtTime(0.1, now + 0.015);
        gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.14);
        osc2.connect(gain2);
        gain2.connect(ctx.destination);
        osc2.start(now + 0.015);
        osc2.stop(now + 0.15);
      } else {
        // --- LAMP TURN OFF: Solid mechanical latch release + resonant descent ---
        playNoiseBurst(ctx, 1600, 0.4, 35);

        // Mechanical latch release
        const osc1 = ctx.createOscillator();
        const gain1 = ctx.createGain();
        osc1.type = 'triangle';
        osc1.frequency.setValueAtTime(740, now);
        osc1.frequency.exponentialRampToValueAtTime(320, now + 0.05);
        gain1.gain.setValueAtTime(0.16, now);
        gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.06);
        osc1.connect(gain1);
        gain1.connect(ctx.destination);
        osc1.start(now);
        osc1.stop(now + 0.06);

        // Deep resonant power-down hum
        const osc2 = ctx.createOscillator();
        const gain2 = ctx.createGain();
        osc2.type = 'sine';
        osc2.frequency.setValueAtTime(420, now + 0.01);
        osc2.frequency.exponentialRampToValueAtTime(180, now + 0.1);
        gain2.gain.setValueAtTime(0.08, now + 0.01);
        gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.12);
        osc2.connect(gain2);
        gain2.connect(ctx.destination);
        osc2.start(now + 0.01);
        osc2.stop(now + 0.13);
      }
    } catch (e) {}
  }

  function playTypeSound() {
    if (!soundEnabled) return;
    try {
      const ctx = getAudioContext();
      if (!ctx) return;

      const osc = ctx.createOscillator();
      const gain = ctx.createGain();

      osc.type = 'sine';
      const now = ctx.currentTime;
      const freq = 900 + Math.random() * 300;
      osc.frequency.setValueAtTime(freq, now);
      osc.frequency.exponentialRampToValueAtTime(freq * 0.6, now + 0.02);

      gain.gain.setValueAtTime(0.04, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.02);

      osc.connect(gain);
      gain.connect(ctx.destination);

      osc.start();
      osc.stop(now + 0.02);
    } catch (e) {}
  }

  function playAccentChime(pick = 'blue') {
    if (!soundEnabled) return;
    try {
      const ctx = getAudioContext();
      if (!ctx) return;
      const now = ctx.currentTime;
      const freqs = {
        blue: 523.25,
        violet: 587.33,
        rose: 659.25,
        amber: 783.99,
        teal: 880.00
      };
      const freq = freqs[pick] || 523.25;

      const osc = ctx.createOscillator();
      const gain = ctx.createGain();

      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, now);
      osc.frequency.exponentialRampToValueAtTime(freq * 1.01, now + 0.18);

      gain.gain.setValueAtTime(0.12, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);

      osc.connect(gain);
      gain.connect(ctx.destination);

      osc.start(now);
      osc.stop(now + 0.22);
    } catch (e) {}
  }

  // Clean up any legacy easter eggs storage
  try {
    localStorage.removeItem('dj-eggs');
  } catch (e) {}

  window.__playClickSound = playBlip;
  window.__playPacmanChomp = playPacmanChomp;
  window.__playLampClick = playLampClick;
  window.__playAccentChime = playAccentChime;
  window.__playTypeSound = playTypeSound;

  window.__toggleSound = function() {
    soundEnabled = !soundEnabled;
    try {
      localStorage.setItem('dj-sound-enabled', String(soundEnabled));
    } catch (e) {}
    
    if (soundEnabled) {
      playBlip(900, 0.05);
    }
    
    // Dispatch event to update navbar buttons
    window.dispatchEvent(new CustomEvent('sound-toggle-changed', { detail: { enabled: soundEnabled } }));
    return soundEnabled;
  };

  window.__isSoundEnabled = function() {
    return soundEnabled;
  };

  // Attach sound to interactive buttons and links
  document.addEventListener('click', (e) => {
    const target = e.target.closest('button, a, summary, [role="button"]');
    if (target && target.id !== 'nav-sound-btn' && !target.closest('#lamp') && !target.closest('#secrets') && !target.hasAttribute('data-pac')) {
      playBlip(750, 0.035);
    }
  }, { passive: true });

  // Developer Console Greeting
  try {
    console.log(
      '%c◈ MD. SHAHIL // Web Developer Portfolio\n%cBuilt with Astro 5, TypeScript, and Tailwind CSS.\nSource: https://github.com/srpranto',
      'color: #7d87ff; font-weight: bold; font-size: 13px;',
      'color: #a0a2a9; font-size: 11px; line-height: 1.5;'
    );
  } catch (e) {}
</script>
