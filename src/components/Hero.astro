---
import { Image } from 'astro:assets';
import profileImage from '../assets/profile.jpg';
import { personalInfo, researchSheetItems } from '../data/portfolio';
import ResearchSheet from './ResearchSheet';
---

<section id="hero" class="relative py-12 md:py-20 border-b border-[var(--edge)] bg-grid-pattern">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Top Metadata Bar: Time & Location & Status -->
    <div class="flex flex-wrap items-center justify-between gap-3 pb-6 border-b border-[var(--edge)] font-mono-code text-xs text-[var(--fg-muted)]">
      <div class="flex flex-wrap items-center gap-2">
        <span class="live-pulse"></span>
        <span class="text-[var(--fg)] font-medium">Rajshahi, Bangladesh</span>
        <span class="text-[var(--fg-faint)]">({personalInfo.utcOffset})</span>
        <span class="text-[var(--edge-strong)] hidden sm:inline">|</span>
        <span id="hero-live-clock" class="text-[var(--fg)] tracking-wider tabular-nums">--:--:-- --</span>
      </div>

      <div class="flex items-center gap-3">
        <span class="badge-mono border-[var(--accent-border)] text-[var(--accent)] bg-[var(--accent-soft)]">
          ● {personalInfo.availability}
        </span>
      </div>
    </div>

    <!-- Main Grid: Left Portrait + Right Typography -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 pt-8 items-start">
      <!-- Portrait Card (Col 1-4) -->
      <div class="lg:col-span-4 flex flex-col gap-4">
        <div class="corner-box p-3 group">
          <div class="relative overflow-hidden aspect-4/5 bg-[var(--panel-alt)] border border-[var(--edge)] img-outline">
            <Image
              src={profileImage}
              alt={personalInfo.avatarAlt}
              class="w-full h-full object-cover object-top grayscale contrast-105 group-hover:grayscale-0 group-hover:scale-102 transition-all duration-500"
              loading="eager"
            />
            
            <div class="absolute inset-0 bg-radial from-transparent to-black/20 pointer-events-none"></div>

            <div class="absolute bottom-2 left-2 right-2 bg-[var(--bg)]/90 backdrop-blur-xs border border-[var(--edge)] px-2.5 py-1 text-[11px] font-mono-code flex items-center justify-between">
              <span class="text-[var(--fg)] font-semibold">{personalInfo.name}</span>
              <span class="text-[var(--accent)] font-medium">DEV.BD</span>
            </div>
          </div>

          <!-- Quick facts beneath photo -->
          <div class="pt-3 flex flex-col gap-1.5 font-mono-code text-[11px] text-[var(--fg-muted)]">
            <div class="flex justify-between border-b border-[var(--edge)] pb-1">
              <span>ROLE:</span>
              <span class="text-[var(--fg)] font-semibold">{personalInfo.designation}</span>
            </div>
            <div class="flex justify-between border-b border-[var(--edge)] pb-1">
              <span>STACK:</span>
              <span class="text-[var(--fg)] font-semibold">React • Next.js • TypeScript</span>
            </div>
            <div class="flex justify-between">
              <span>LOCATION:</span>
              <span class="text-[var(--fg)]">Rajshahi, Bangladesh</span>
            </div>
          </div>
        </div>

        <!-- Social Profile Links (Requirement 4) -->
        <div class="corner-box p-3.5">
          <div class="text-[11px] font-mono-code text-[var(--fg-muted)] uppercase tracking-wider mb-2.5 font-semibold">
            Profiles & Socials
          </div>
          <div class="grid grid-cols-2 gap-1.5 font-mono-code text-xs">
            <a
              href={personalInfo.socialLinks.github}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1.5 px-2.5 py-1.5 border border-[var(--edge)] bg-[var(--panel-alt)] hover:bg-[var(--fg)] hover:text-[var(--bg)] hover:border-[var(--fg)] transition-all rounded-xs"
            >
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
              <span>GitHub</span>
            </a>
            <a
              href={personalInfo.socialLinks.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1.5 px-2.5 py-1.5 border border-[var(--edge)] bg-[var(--panel-alt)] hover:bg-[var(--fg)] hover:text-[var(--bg)] hover:border-[var(--fg)] transition-all rounded-xs"
            >
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              <span>LinkedIn</span>
            </a>
            <a
              href={personalInfo.socialLinks.twitter}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1.5 px-2.5 py-1.5 border border-[var(--edge)] bg-[var(--panel-alt)] hover:bg-[var(--fg)] hover:text-[var(--bg)] hover:border-[var(--fg)] transition-all rounded-xs"
            >
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              <span>Twitter / X</span>
            </a>
            <a
              href={personalInfo.socialLinks.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1.5 px-2.5 py-1.5 border border-[var(--edge)] bg-[var(--panel-alt)] hover:bg-[var(--fg)] hover:text-[var(--bg)] hover:border-[var(--fg)] transition-all rounded-xs"
            >
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.657 5H18V0h-3.808C10.597 0 9 1.583 9 4.615V8z"/></svg>
              <span>Facebook</span>
            </a>
            <a
              href={personalInfo.socialLinks.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="col-span-2 flex items-center justify-center gap-1.5 px-2.5 py-1.5 border border-[var(--edge)] bg-[var(--panel-alt)] hover:bg-[var(--fg)] hover:text-[var(--bg)] hover:border-[var(--fg)] transition-all rounded-xs"
            >
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              <span>Instagram</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Main Headline & Bio & Action Buttons (Col 5-12) -->
      <div class="lg:col-span-8 flex flex-col gap-6">
        <!-- Section Tag -->
        <div class="flex items-center gap-2 font-mono-code text-xs text-[var(--fg-muted)]">
          <span class="text-[var(--accent)] font-semibold">00 //</span>
          <span class="uppercase tracking-wider font-semibold text-[var(--fg)]">MD. SHAHIL</span>
          <span class="text-[var(--edge-strong)]">•</span>
          <span>Web Developer</span>
        </div>

        <!-- Confident, Natural Sentence Case Heading -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-[-0.025em] text-[var(--fg)] leading-[1.14] text-balance">
          Building clean web applications with React, Next.js, and TypeScript.
        </h1>

        <!-- Bio Lede -->
        <p class="text-base sm:text-lg text-[var(--fg-muted)] leading-relaxed max-w-2xl text-pretty">
          {personalInfo.bioIntro}
        </p>

        <!-- Hero CTAs (devjhawar.com 1:1 Parity) -->
        <div class="flex flex-wrap items-center gap-3 pt-1">
          <!-- Primary CTA: Get in touch -->
          <a
            href="#contact"
            id="hero-contact-btn"
            class="btn-dj btn-dj-accent text-sm px-5 py-2.5 font-medium transition-all duration-150 hover:shadow-sm"
          >
            <span>Get in touch</span>
            <span class="text-xs transition-transform duration-150 group-hover:translate-x-0.5">→</span>
          </a>

          <!-- Secondary CTA: See projects -->
          <a
            href="#projects"
            id="hero-projects-btn"
            class="btn-dj text-sm px-4 py-2.5 font-medium transition-all duration-150 hover:border-[var(--edge-strong)]"
          >
            <span>See projects</span>
          </a>

          <!-- Devjhawar Parity: In a hurry? 60-second view -->
          <a
            href="/quick"
            id="hero-quick-btn"
            class="btn-dj text-sm px-4 py-2.5 font-medium group transition-all duration-150 hover:border-[var(--accent)]"
            title="Read candidate summary in 60 seconds"
          >
            <span class="inline-block w-2 h-2 rounded-full bg-[var(--accent)] mr-1.5 animate-pulse" aria-hidden="true"></span>
            <span>In a hurry? 60-second view</span>
            <span class="text-[var(--fg-muted)] group-hover:text-[var(--fg)] group-hover:translate-x-0.5 transition-all text-xs" aria-hidden="true">→</span>
          </a>
        </div>

        <!-- Research Sheet Accordion -->
        <ResearchSheet client:visible items={researchSheetItems} />
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Live local time clock for Rajshahi, Bangladesh (UTC+6)
  function updateRajshahiClock() {
    const clockEl = document.getElementById('hero-live-clock');
    if (!clockEl) return;

    const now = new Date();
    const options = {
      timeZone: 'Asia/Dhaka',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: true
    };
    try {
      const timeStr = new Intl.DateTimeFormat('en-US', options).format(now);
      clockEl.textContent = `${timeStr} BST`;
    } catch (e) {
      clockEl.textContent = now.toLocaleTimeString();
    }
  }

  updateRajshahiClock();
  setInterval(updateRajshahiClock, 1000);
</script>
