---
import { personalInfo, developerSecrets } from '../data/portfolio';
---

<div
  class="secrets hidden fixed sm:absolute z-50 bg-[var(--panel)] border border-[var(--fg)] shadow-[6px_6px_0_color-mix(in_srgb,var(--fg)_15%,transparent)] font-mono-code text-xs"
  id="secrets"
  role="dialog"
  aria-labelledby="secrets-title"
  data-secrets={JSON.stringify(developerSecrets)}
  data-email={personalInfo.email}
>
  <!-- Window Header Bar -->
  <div class="px-3 py-2 bg-[var(--panel-alt)] border-b border-[var(--edge)] flex items-center justify-between select-none">
    <span id="secrets-title" class="flex items-center gap-2 text-[var(--fg)] font-semibold text-[11px]">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>shahil@pranto: ~/secrets</span>
    </span>

    <div class="flex items-center gap-2">
      <button
        type="button"
        class="text-[10px] px-2 py-0.5 border border-[var(--edge)] bg-[var(--panel)] text-[var(--fg-muted)] hover:text-[var(--fg)] hover:border-[var(--fg)] transition-all rounded-xs cursor-pointer"
        data-sound
        aria-pressed="true"
      >
        sound on
      </button>
      <button
        type="button"
        class="text-[var(--fg-muted)] hover:text-[var(--fg)] p-0.5 cursor-pointer"
        data-close
        aria-label="Close secrets console"
      >
        <svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="m2 2 8 8M10 2l-8 8"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Terminal Output Screen -->
  <div
    class="out p-4 text-[11px] leading-relaxed max-h-[360px] overflow-y-auto space-y-2 text-[var(--fg)] select-text"
    data-out
    aria-live="polite"
  >
  </div>
</div>

<style>
  .secrets {
    width: min(29rem, calc(100vw - 2rem));
    top: calc(100% + 0.5rem);
    left: 0;
    animation: secrets-pop 0.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (max-width: 640px) {
    .secrets {
      top: 4.5rem;
      left: 1rem;
      right: 1rem;
      width: auto;
    }
  }

  @keyframes secrets-pop {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  :global(.sec-cmd) {
    color: var(--accent);
    font-weight: 600;
  }

  :global(.sec-num) {
    color: var(--accent);
    font-weight: 600;
    margin-right: 0.5rem;
    user-select: none;
  }

  :global(.sec-line) {
    color: var(--fg);
  }

  :global(.sec-cur) {
    display: inline-block;
    width: 6px;
    height: 12px;
    background: var(--accent);
    margin-left: 3px;
    vertical-align: middle;
    animation: blink 0.8s infinite;
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }
</style>

<script>
  function setupSecretsModal() {
    const modal = document.getElementById('secrets');
    if (!modal) return;

    const out = modal.querySelector('[data-out]') as HTMLElement;
    const soundBtn = modal.querySelector('[data-sound]') as HTMLButtonElement;
    const closeBtn = modal.querySelector('[data-close]') as HTMLButtonElement;
    const secrets: string[] = JSON.parse(modal.dataset.secrets || '[]');
    const email = modal.dataset.email || 'personalshahil69@gmail.com';

    let runId = 0;
    let isTyping = false;

    // Sound toggle state
    function updateSoundBtn() {
      const isSoundOn = typeof window.__isSoundEnabled === 'function' ? window.__isSoundEnabled() : true;
      soundBtn.textContent = isSoundOn ? 'sound on' : 'sound off';
      soundBtn.setAttribute('aria-pressed', String(isSoundOn));
    }
    updateSoundBtn();
    window.addEventListener('sound-toggle-changed', updateSoundBtn);

    soundBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (typeof window.__toggleSound === 'function') {
        window.__toggleSound();
      }
      updateSoundBtn();
    });

    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeSecrets();
    });

    function closeSecrets() {
      modal?.classList.add('hidden');
      isTyping = false;
      runId++;
    }

    // Export toggle to global scope so Navbar logo can trigger it
    window.__toggleSecretsModal = function() {
      if (!modal) return;
      if (!modal.classList.contains('hidden')) {
        closeSecrets();
      } else {
        openSecrets();
      }
    };

    const sleep = (ms: number) => new Promise(res => setTimeout(res, ms));

    async function typeText(targetEl: HTMLElement, text: string, currentRun: number) {
      for (const char of text) {
        if (currentRun !== runId) return;
        targetEl.textContent += char;
        out.scrollTop = out.scrollHeight;
        if (typeof window.__playTypeSound === 'function') {
          window.__playTypeSound();
        }
        await sleep(20);
      }
    }

    async function openSecrets() {
      if (!modal) return;
      if (isTyping) return;
      modal.classList.remove('hidden');
      out.innerHTML = '';
      const currentRun = ++runId;
      isTyping = true;

      await sleep(150);

      // 1. cat secrets.log
      const cmd1 = document.createElement('div');
      cmd1.className = 'sec-cmd flex items-center gap-1.5';
      cmd1.innerHTML = '<span class="text-emerald-500 font-semibold">$</span> ';
      const cmd1Text = document.createElement('span');
      cmd1.appendChild(cmd1Text);
      out.appendChild(cmd1);
      await typeText(cmd1Text, 'cat secrets.log', currentRun);
      if (currentRun !== runId) return;

      await sleep(250);

      // 2. Type secrets one by one
      for (let i = 0; i < secrets.length; i++) {
        if (currentRun !== runId) return;
        const line = document.createElement('div');
        line.className = 'sec-line flex items-start gap-2 pl-2';
        const num = String(i + 1).padStart(2, '0');
        line.innerHTML = `<span class="sec-num">${num}</span><span>${secrets[i]}</span>`;
        out.appendChild(line);
        out.scrollTop = out.scrollHeight;
        if (typeof window.__playClickSound === 'function') {
          window.__playClickSound(800, 0.02);
        }
        await sleep(350);
      }

      await sleep(350);

      // 3. whoami --still-here
      if (currentRun !== runId) return;
      const cmd2 = document.createElement('div');
      cmd2.className = 'sec-cmd flex items-center gap-1.5 pt-2';
      cmd2.innerHTML = '<span class="text-emerald-500 font-semibold">$</span> ';
      const cmd2Text = document.createElement('span');
      cmd2.appendChild(cmd2Text);
      out.appendChild(cmd2);
      await typeText(cmd2Text, 'whoami --still-here', currentRun);
      if (currentRun !== runId) return;

      await sleep(300);

      // 4. Still reading note
      if (currentRun !== runId) return;
      const note = document.createElement('div');
      note.className = 'text-[var(--fg-muted)] pl-2 italic';
      note.textContent = "Still reading? Then you're curious. So am I. Let's talk.";
      out.appendChild(note);
      out.scrollTop = out.scrollHeight;

      await sleep(250);

      // 5. mail link CTA with blinking cursor
      if (currentRun !== runId) return;
      const mailRow = document.createElement('div');
      mailRow.className = 'pt-2 pl-2 flex items-center gap-1.5 font-semibold';
      const mailLink = document.createElement('a');
      mailLink.href = `mailto:${email}?subject=Found%20your%20secrets`;
      mailLink.className = 'text-[var(--accent)] underline hover:text-[var(--fg)] transition-colors';
      mailLink.textContent = `mail ${email}`;
      const cursor = document.createElement('span');
      cursor.className = 'sec-cur';
      mailRow.appendChild(mailLink);
      mailRow.appendChild(cursor);
      out.appendChild(mailRow);
      out.scrollTop = out.scrollHeight;

      isTyping = false;
    }

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!modal.classList.contains('hidden') && !modal.contains(target) && !target.closest('#nav-brand-logo')) {
        closeSecrets();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeSecrets();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSecretsModal);
  } else {
    setupSecretsModal();
  }
</script>
