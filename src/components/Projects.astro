---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { projectsData } from '../data/portfolio';

import lunaImg from '../assets/projects/luna-live.png';
import bookVibeImg from '../assets/projects/book-vibe-live.png';
import countriesImg from '../assets/projects/countries-explorer-live.png';
import bazarDorImg from '../assets/projects/bazar-dor-live.png';
import hateyhatImg from '../assets/projects/hateyhat-live.png';

const projectImages: Record<string, ImageMetadata> = {
  luna: lunaImg,
  'book-vibe': bookVibeImg,
  'countries-explorer': countriesImg,
  'bazar-dor': bazarDorImg,
  hateyhat: hateyhatImg,
};
---

<section id="projects" class="py-16 md:py-24 border-b border-[var(--edge)] bg-[var(--bg)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Section Header -->
    <div class="flex items-center justify-between pb-6 border-b border-[var(--edge)] font-mono-code text-xs text-[var(--fg-muted)]">
      <div class="flex items-center gap-2">
        <span class="text-[var(--accent)] font-semibold">03 //</span>
        <span class="uppercase tracking-wider font-semibold text-[var(--fg)]">PROJECTS</span>
      </div>
      <span class="badge-mono">{projectsData.length} projects</span>
    </div>

    <!-- Intro Headline -->
    <div class="pt-8 pb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[var(--fg)]">
          Selected Projects
        </h2>
        <p class="text-sm text-[var(--fg-muted)] mt-1 text-pretty font-sans">
          Applications built with a focus on speed, clear interfaces, and practical utility.
        </p>
      </div>

      <div class="font-mono-code text-xs text-[var(--fg-muted)]">
        Select any project to explore the case study
      </div>
    </div>

    <!-- Projects Grid: Flagship card 01 horizontal split + 4 standard cards (Requirement 9) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-7">
      {projectsData.map((project, idx) => {
        if (idx === 0) {
          /* Flagship horizontal card 01 */
          return (
            <article class="corner-box md:col-span-2 group hover:border-[var(--accent-border)] transition-all overflow-hidden flex flex-col lg:flex-row bg-[var(--panel)]">
              <!-- Left side: Media preview ~58% width -->
              <div class="lg:w-[58%] relative overflow-hidden bg-[var(--panel-alt)] border-b lg:border-b-0 lg:border-r border-[var(--edge)] min-h-[260px] lg:min-h-[380px] img-outline">
                <Image
                  src={projectImages[project.slug]}
                  alt={`${project.title} - ${project.tagline}`}
                  class="absolute inset-0 w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent"></div>

                <!-- Floating top badges -->
                <div class="absolute top-3.5 left-3.5 right-3.5 flex items-center justify-between font-mono-code text-xs z-10">
                  <span class="badge-mono bg-black/70 text-white border-white/20 backdrop-blur-xs">
                    01 // FEATURED
                  </span>
                  <span class="badge-mono bg-emerald-950/80 text-emerald-300 border-emerald-500/30 backdrop-blur-xs flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    {project.status}
                  </span>
                </div>

                <!-- Floating bottom info on image -->
                <div class="absolute bottom-3.5 left-3.5 right-3.5 font-mono-code text-xs text-white z-10">
                  <div class="text-xs uppercase tracking-wider text-[var(--accent)] font-semibold">
                    {project.category}
                  </div>
                  <div class="text-lg font-bold text-white tracking-tight">
                    {project.title}
                  </div>
                </div>
              </div>

              <!-- Right side: Content & Actions ~42% width -->
              <div class="lg:w-[42%] p-6 lg:p-7 flex flex-col justify-between bg-[var(--panel)]">
                <div>
                  <div class="flex items-center justify-between text-xs font-mono-code text-[var(--fg-muted)] mb-2">
                    <span class="text-[var(--accent)] font-semibold">01 / 0{projectsData.length}</span>
                    <span class="tabular-nums">{project.year}</span>
                  </div>

                  <h3 class="text-xl sm:text-2xl font-bold text-[var(--fg)] tracking-tight">
                    {project.title}
                  </h3>
                  <p class="text-xs font-mono-code text-[var(--accent)] mt-0.5">
                    {project.tagline}
                  </p>

                  <p class="text-xs sm:text-sm text-[var(--fg-muted)] leading-relaxed font-sans mt-3 text-pretty">
                    {project.description}
                  </p>

                  <!-- Tech stack badges -->
                  <div class="mt-4 pt-3 border-t border-[var(--edge)]">
                    <div class="text-[10px] font-mono-code uppercase tracking-wider text-[var(--fg-faint)] font-semibold mb-1.5">
                      Stack:
                    </div>
                    <div class="flex flex-wrap gap-1.5">
                      {project.techStack.map((tech) => (
                        <span class="badge-mono text-[10px] bg-[var(--panel-alt)]">{tech.name}</span>
                      ))}
                    </div>
                  </div>
                </div>

                <!-- Flagship Card Footer Action Buttons (Requirement 9) -->
                <div class="pt-5 mt-5 border-t border-[var(--edge)] flex flex-wrap items-center justify-between gap-2">
                  <a
                    href={`/projects/${project.slug}`}
                    class="btn-dj btn-dj-primary text-xs py-2 px-3.5 group/btn"
                    title={`Read case study for ${project.title}`}
                  >
                    <span>Read Case Study</span>
                    <svg class="w-3.5 h-3.5 transition-transform group-hover/btn:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                  </a>

                  <div class="flex items-center gap-2 font-mono-code text-xs">
                    <a
                      href={project.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-dj text-xs py-1.5 px-2.5"
                      title="Open live website"
                    >
                      <span>Live Demo ↗</span>
                    </a>
                    <a
                      href={project.githubClientUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-dj text-xs py-1.5 px-2.5"
                      title="View code on GitHub"
                    >
                      <span>GitHub ↗</span>
                    </a>
                  </div>
                </div>
              </div>
            </article>
          );
        }

        /* Standard 2-column cards 02 to 05 */
        return (
          <article class="corner-box flex flex-col justify-between group hover:border-[var(--accent-border)] transition-all overflow-hidden bg-[var(--panel)]">
            <div>
              <!-- Project Image Frame with live badges & hover effects -->
              <div class="relative overflow-hidden aspect-16/10 bg-[var(--panel-alt)] border-b border-[var(--edge)] img-outline">
                <Image
                  src={projectImages[project.slug]}
                  alt={`${project.title} - ${project.tagline}`}
                  class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>

                <!-- Top floating badges -->
                <div class="absolute top-3 left-3 right-3 flex items-center justify-between font-mono-code text-xs z-10">
                  <span class="badge-mono bg-black/70 text-white border-white/20 backdrop-blur-xs">
                    0{idx + 1} // {project.category}
                  </span>
                  <span class="badge-mono bg-emerald-950/80 text-emerald-300 border-emerald-500/30 backdrop-blur-xs flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    {project.status}
                  </span>
                </div>

                <!-- Bottom overlay title in photo -->
                <div class="absolute bottom-3 left-3 right-3 font-mono-code text-xs text-white z-10">
                  <div class="text-base font-bold tracking-tight">{project.title}</div>
                  <div class="text-[11px] text-gray-300 font-normal truncate">{project.tagline}</div>
                </div>
              </div>

              <!-- Card Body Content -->
              <div class="p-6 space-y-4">
                <p class="text-xs sm:text-sm text-[var(--fg-muted)] leading-relaxed font-sans line-clamp-3 text-pretty">
                  {project.description}
                </p>

                <!-- Tech Stack Badges -->
                <div class="space-y-1.5">
                  <div class="text-[10px] font-mono-code uppercase tracking-wider text-[var(--fg-faint)] font-semibold">
                    Technologies Used:
                  </div>
                  <div class="flex flex-wrap gap-1.5">
                    {project.techStack.map((tech) => (
                      <span class="badge-mono text-[10px] bg-[var(--panel-alt)]">{tech.name}</span>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <!-- Card Footer Action Buttons (Requirement 9) -->
            <div class="p-5 border-t border-[var(--edge)] bg-[var(--panel-alt)] flex flex-wrap items-center justify-between gap-2">
              <a
                href={`/projects/${project.slug}`}
                class="btn-dj btn-dj-primary text-xs py-2 px-3 group/btn"
                title={`Read case study for ${project.title}`}
              >
                <span>Read Case Study</span>
                <svg class="w-3.5 h-3.5 transition-transform group-hover/btn:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>

              <div class="flex items-center gap-2 font-mono-code text-xs">
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-dj text-xs py-1.5 px-2.5"
                  title="Open live website"
                >
                  <span>Live Demo ↗</span>
                </a>
                <a
                  href={project.githubClientUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-dj text-xs py-1.5 px-2.5"
                  title="View code on GitHub"
                >
                  <span>GitHub ↗</span>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
